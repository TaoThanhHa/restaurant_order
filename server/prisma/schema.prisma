generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model Branch {
  id              Int              @id @default(autoincrement())
  name            String
  address         String?
  phone           String?
  email           String           @unique
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  restaurantId    Int?             @map("restaurant_id")
  kitchenMode     KitchenMode      @default(PRINT)
  branchFoods     BranchFood[]
  restaurant      Restaurant?      @relation(fields: [restaurantId], references: [id])
  floors          Floor[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  users           User[]

  @@map("branches")
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String?
  adminId   Int      @unique @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  branches  Branch[]
  admin     User     @relation("RestaurantAdmin", fields: [adminId], references: [id])

  @@map("restaurants")
}

model User {
  id                     Int              @id @default(autoincrement())
  username               String           @unique
  password               String
  email                  String           @unique
  isActive               Boolean          @default(true)
  mustChangePassword     Boolean          @default(true)
  roleId                 Int              @map("role_id")
  branchId               Int?             @map("branch_id")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  endedSessions          DiningSession[]
  emailChangeOtps        EmailChangeOtp[]
  createdOrders          Order[]          @relation("UserCreatedOrders")
  restaurant             Restaurant?      @relation("RestaurantAdmin")
  handledServiceRequests ServiceRequest[]
  branch                 Branch?          @relation(fields: [branchId], references: [id])
  role                   Role             @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Floor {
  id          Int      @id @default(autoincrement())
  branchId    Int      @map("branch_id")
  floorNumber Int      @map("floor_number")
  name        String?
  createdAt   DateTime @default(now()) @map("created_at")
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables      Table[]

  @@unique([branchId, floorNumber])
  @@map("floors")
}

model Table {
  id              Int                @id @default(autoincrement())
  floorId         Int                @map("floor_id")
  tableNumber     Int                @map("table_number")
  qrCode          String             @unique @map("qr_code")
  status          TableStatus        @default(AVAILABLE)
  createdAt       DateTime           @default(now()) @map("created_at")
  capacity        Int                @default(4)
  customers       Customer[]
  sessions        DiningSession[]
  reservations    ReservationTable[]
  serviceRequests ServiceRequest[]
  floor           Floor              @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@unique([floorId, tableNumber])
  @@map("tables")
}

model Reservation {
  id              Int                @id @default(autoincrement())
  customerName    String             @map("customer_name")
  customerPhone   String             @map("customer_phone")
  numberOfGuests  Int                @map("number_of_guests")
  reservationTime DateTime           @map("reservation_time")
  status          ReservationStatus  @default(PENDING)
  note            String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  sessions        DiningSession[]
  tables          ReservationTable[]

  @@index([reservationTime])
  @@index([status])
  @@map("reservations")
}

model ReservationTable {
  reservationId Int         @map("reservation_id")
  tableId       Int         @map("table_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table         Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@id([reservationId, tableId])
  @@index([tableId])
  @@map("reservation_tables")
}

model ServiceRequest {
  id          Int                  @id @default(autoincrement())
  branchId    Int                  @map("branch_id")
  tableId     Int                  @map("table_id")
  customerId  Int?                 @map("customer_id")
  message     String
  status      ServiceRequestStatus @default(PENDING)
  handledById Int?                 @map("handled_by_id")
  handledAt   DateTime?            @map("handled_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  branch      Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer    Customer?            @relation(fields: [customerId], references: [id])
  handledBy   User?                @relation(fields: [handledById], references: [id])
  table       Table                @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([tableId])
  @@index([status])
  @@index([createdAt])
  @@map("service_requests")
}

model DiningSession {
  id            Int                 @id @default(autoincrement())
  tableId       Int                 @map("table_id")
  status        DiningSessionStatus @default(ACTIVE)
  startedAt     DateTime            @default(now())
  closedAt      DateTime?
  endedById     Int?                @map("ended_by")
  note          String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  reservationId Int?                @map("reservation_id")
  customers     Customer[]
  endedBy       User?               @relation(fields: [endedById], references: [id])
  reservation   Reservation?        @relation(fields: [reservationId], references: [id])
  table         Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([reservationId])
  @@map("dining_sessions")
}

model Cart {
  id         Int        @id @default(autoincrement())
  customerId Int        @unique
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  items      CartItem[]
  customer   Customer   @relation(fields: [customerId], references: [id])

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  foodId    Int
  quantity  Int      @default(1)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  cart      Cart     @relation(fields: [cartId], references: [id])
  food      Food     @relation(fields: [foodId], references: [id])

  @@unique([cartId, foodId])
  @@map("cart_items")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  foods       Food[]

  @@map("categories")
}

model Food {
  id          Int          @id @default(autoincrement())
  categoryId  Int          @map("category_id")
  name        String
  price       Decimal      @db.Decimal(12, 2)
  description String?
  image       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  branchFoods BranchFood[]
  cartItems   CartItem[]
  category    Category     @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@unique([categoryId, name])
  @@map("foods")
}

model BranchFood {
  id        Int        @id @default(autoincrement())
  branchId  Int        @map("branch_id")
  foodId    Int        @map("food_id")
  status    FoodStatus @default(AVAILABLE)
  updatedAt DateTime   @updatedAt @map("updated_at")
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  food      Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([branchId, foodId])
  @@map("branch_foods")
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_otps")
}

model EmailChangeOtp {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  newEmail  String   @map("new_email")
  otp       String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_otps")
}

model Customer {
  id                Int              @id @default(autoincrement())
  sessionId         Int?             @map("session_id")
  name              String?
  guestToken        String?          @unique @map("guest_token")
  createdAt         DateTime         @default(now()) @map("created_at")
  expiredAt         DateTime?        @map("expired_at")
  password          String?
  phone             String?          @unique
  email             String?          @unique
  isGuest           Boolean          @default(true)
  isActive          Boolean          @default(true)
  deviceId          String?          @unique @map("device_id")
  tableId           Int?             @map("table_id")
  emailOtp          String?
  emailOtpExpiresAt DateTime?
  currentOrderId    Int?
  avatar            String?
  cart              Cart?
  currentOrder      Order?           @relation("CustomerCurrentOrder", fields: [currentOrderId], references: [id])
  session           DiningSession?   @relation(fields: [sessionId], references: [id])
  table             Table?           @relation(fields: [tableId], references: [id])
  orderMembers      OrderMember[]
  createdOrders     Order[]          @relation("CustomerCreatedOrders")
  serviceRequests   ServiceRequest[]

  @@map("customers")
}

model Order {
  id                  Int            @id @default(autoincrement())
  orderCode           String         @unique @map("order_code")
  branchId            Int            @map("branch_id")
  sessionId           Int?           @map("session_id")
  orderType           OrderType      @default(DINE_IN)
  status              OrderStatus    @default(PENDING)
  totalAmount         Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  note                String?
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  createdByCustomerId Int?           @map("created_by_customer_id")
  createdByUserId     Int?           @map("created_by_user_id")
  currentCustomers    Customer[]     @relation("CustomerCurrentOrder")
  orderItems          OrderItem[]
  orderMembers        OrderMember[]
  branch              Branch         @relation(fields: [branchId], references: [id])
  createdByCustomer   Customer?      @relation("CustomerCreatedOrders", fields: [createdByCustomerId], references: [id])
  createdByUser       User?          @relation("UserCreatedOrders", fields: [createdByUserId], references: [id])
  session             DiningSession? @relation(fields: [sessionId], references: [id])
  payment             Payment?

  @@index([branchId])
  @@index([sessionId])
  @@index([status])
  @@index([createdByUserId])
  @@index([createdByCustomerId])
  @@map("orders")
}

model OrderMember {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  orderId    Int      @map("order_id")
  joinedAt   DateTime @default(now()) @map("joined_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([customerId, orderId])
  @@index([orderId])
  @@index([customerId])
  @@map("order_members")
}

model OrderItem {
  id                 Int               @id @default(autoincrement())
  orderId            Int               @map("order_id")
  foodId             Int               @map("food_id")
  quantity           Int
  status             OrderItemStatus   @default(PENDING)
  price              Decimal           @db.Decimal(12, 2)
  note               String?
  createdAt DateTime @default(now()) @map("created_at")
  kitchenCompletedAt DateTime?         @map("kitchen_completed_at")
  kitchenReadyAt     DateTime?         @map("kitchen_ready_at")
  kitchenSentAt      DateTime?         @map("kitchen_sent_at")
  kitchenStatus      KitchenItemStatus @default(WAITING) @map("kitchen_status")
  food               Food              @relation(fields: [foodId], references: [id])
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("order_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique @map("order_id")
  paymentMethod PaymentMethod @map("payment_method")
  cashAmount    Decimal?
  bankAmount    Decimal?
  paymentCode   String?       @map("payment_code")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  paidAt        DateTime?     @map("paid_at")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DISABLED
}

enum DiningSessionStatus {
  ACTIVE
  CLOSED
}

enum FoodStatus {
  AVAILABLE
  OUT_OF_STOCK
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  PREPARING
  SERVED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
}

enum PaymentMethod {
  CASH
  BANKING
  MIXED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ServiceRequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum KitchenMode {
  SCREEN
  PRINT
}

enum KitchenItemStatus {
  WAITING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
